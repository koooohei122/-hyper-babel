# ════════════════════════════════════════════════════════════════════
#  Hyper Babel — environment variables
# ════════════════════════════════════════════════════════════════════
#
#  Choose ONE backend by setting TRANSLATION_BACKEND
#
#  ┌─────────────┬──────────────────────┬──────────┬──────────────┐
#  │ Backend     │ What you need        │ Cost     │ Quality      │
#  ├─────────────┼──────────────────────┼──────────┼──────────────┤
#  │ local       │ nothing (auto DL)    │ FREE     │ ★★★★         │
#  │ ollama      │ Ollama + model pull  │ FREE     │ ★★★★★        │
#  │ gemini      │ Google AI API key    │ FREE*    │ ★★★★★        │
#  └─────────────┴──────────────────────┴──────────┴──────────────┘
#  * Gemini: free tier 1500 req/day, no credit card
#
# ────────────────────────────────────────────────────────────────
TRANSLATION_BACKEND=local


# ── LOCAL backend (NLLB-200 via @huggingface/transformers) ────────
#  Downloads ~350 MB on first run → cached in .cache/models/
#  Runs 100% offline afterwards.
#
# LOCAL_MODEL=Xenova/nllb-200-distilled-600M
# LOCAL_DTYPE=q8          # q4 (smaller/faster) | q8 (default) | fp32 (best quality)


# ── OLLAMA backend ─────────────────────────────────────────────────
#  1. Install Ollama  →  https://ollama.com/download
#  2. Pull a model    →  ollama pull gemma3           (~2.5 GB)
#                        ollama pull llama3.2:3b      (~2.0 GB, lighter)
#  3. Set TRANSLATION_BACKEND=ollama
#
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3


# ── GEMINI backend ─────────────────────────────────────────────────
#  1. Visit  https://aistudio.google.com/apikey
#  2. Click "Create API key" (no credit card required)
#  3. Set TRANSLATION_BACKEND=gemini  and fill in the key below
#
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash


# ── General ────────────────────────────────────────────────────────
# PORT=3000
