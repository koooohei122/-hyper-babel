# ────────────────────────────────────────────────────────────────
#  Hyper Babel — environment variables
# ────────────────────────────────────────────────────────────────
#
#  GOOGLE_API_KEY  (required — free, no credit card needed)
#  -------------------------------------------------------
#  1. Open https://aistudio.google.com/apikey
#  2. Click "Create API key" → choose a project (or create one)
#  3. Copy the key and paste it below
#
#  Free tier limits (as of 2026):
#    gemini-2.0-flash  →  15 RPM  · 1 500 RPD  · 1 M TPM
#    gemini-2.0-flash-lite  →  30 RPM  · 1 500 RPD  · 1 M TPM  (faster/lighter)
#
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash-lite

# Optional: change the port (default: 3000)
# PORT=3000
